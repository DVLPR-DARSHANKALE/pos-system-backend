# =========================
# Application
# =========================
NODE_ENV=development
PORT=5000
APP_NAME=express-postgres-api
LOG_LEVEL=info

CLIENT_URL=http://localhost:3000


# =========================
# JWT
# =========================
JWT_ACCESS_SECRET=your_access_secret_min_16_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_16_chars

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# =========================
# AWS / S3
# =========================
AMAZON_AWS_ACCESS_KEY=
AWS_ACCESS_KEY_SECRET=

AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-bucket-name
AWS_CLOUDFRONT_DISTRIBUTION_ID=

CDN_BASE_URL=https://cdn.kokki.in
UPLOAD_MAX_FILE_SIZE_MB=15


# =========================
# Email
# =========================
EMAIL_FROM=noreply@example.com
LOGO_URL=https://example.com/logo.png